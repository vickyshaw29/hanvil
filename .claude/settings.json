{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)", "Bash(cargo check:*)", "Bash(cargo test:*)", "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)", "Bash(cargo doc:*)", "Bash(cargo run:*)", "Bash(cargo tree:*)",
      "Bash(cargo add:*)", "Bash(cargo deny:*)", "Bash(cargo metadata:*)", "Bash(rustfmt:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git branch:*)", "Bash(git checkout:*)", "Bash(git switch:*)",
      "Bash(git fetch:*)", "Bash(git rebase:*)", "Bash(git stash:*)", "Bash(git show:*)",
      "Bash(node:*)", "Bash(npm test:*)", "Bash(npm run:*)", "Bash(npm ci:*)", "Bash(npx hedera-harness:*)",
      "Bash(curl -s http://127.0.0.1:*)", "Bash(curl -s http://localhost:*)",
      "Bash(grpcurl:*)", "Bash(protoc:*)",
      "Bash(rg:*)", "Bash(grep:*)", "Bash(find:*)", "Bash(ls:*)", "Bash(cat:*)", "Bash(sed -n:*)",
      "Bash(wc:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(shasum:*)", "Bash(python3:*)",
      "Read(//Users/vicky/Desktop/dev/hanvil/**)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)",
      "Bash(rm -rf /:*)", "Bash(sudo:*)",
      "Read(//Users/vicky/Desktop/dev/hanvil/.harness/runs/**/chain-signer.json)",
      "Read(//Users/vicky/.ssh/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/Users/vicky/Desktop/dev/hanvil/.claude/hooks/pre-commit-gate.sh", "timeout": 600 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "/Users/vicky/Desktop/dev/hanvil/.claude/hooks/fmt-on-write.sh", "timeout": 60 }
        ]
      }
    ]
  }
}
